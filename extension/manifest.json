{
  "manifest_version": 3,
  "name": "Kai WebBridge",
  "version": "0.1.4",
  "description": "Let a local AI agent drive your real Chrome through the Kai WebBridge daemon. Open source, no telemetry.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kai WebBridge",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "debugger",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Kai WebBridge side panel"
    }
  }
}
