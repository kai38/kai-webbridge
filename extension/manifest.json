{
  "manifest_version": 3,
  "name": "Kai WebBridge",
  "version": "0.1.1",
  "description": "Let a local AI agent drive your real Chrome through the Kai WebBridge daemon. Open source, no telemetry.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kai WebBridge",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "debugger",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
