{
  "manifest_version": 3,
  "name": "Kai WebBridge",
  "version": "0.1.0",
  "description": "Let a local AI agent drive your real Chrome through the Kai WebBridge daemon. Open source, no telemetry.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kai WebBridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["tabs", "debugger", "tabGroups", "storage", "alarms", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
